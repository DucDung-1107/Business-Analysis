{
  "$defs": {
    "FeatureRow": {
      "additionalProperties": false,
      "properties": {
        "customer_id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Customer Id",
          "type": "string"
        },
        "age": {
          "maximum": 100,
          "minimum": 18,
          "title": "Age",
          "type": "integer"
        },
        "balance": {
          "minimum": 0,
          "title": "Balance",
          "type": "number"
        },
        "transaction_count": {
          "minimum": 0,
          "title": "Transaction Count",
          "type": "integer"
        },
        "transaction_amount": {
          "minimum": 0,
          "title": "Transaction Amount",
          "type": "number"
        },
        "login_count": {
          "minimum": 0,
          "title": "Login Count",
          "type": "integer"
        },
        "complaint_count": {
          "minimum": 0,
          "title": "Complaint Count",
          "type": "integer"
        },
        "mobile_share": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mobile Share",
          "type": "number"
        }
      },
      "required": [
        "customer_id",
        "age",
        "balance",
        "transaction_count",
        "transaction_amount",
        "login_count",
        "complaint_count",
        "mobile_share"
      ],
      "title": "FeatureRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "customers": {
      "items": {
        "$ref": "#/$defs/FeatureRow"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Customers",
      "type": "array"
    }
  },
  "required": [
    "contract_version",
    "customers"
  ],
  "title": "PredictRequest",
  "type": "object"
}
